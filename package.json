    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
